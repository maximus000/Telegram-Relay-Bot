# Telegram Bot Configuration

# Your bot token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Target chat ID (admin user or group)
# For personal admin: Your user ID (e.g., 123456789)
# For group: Group chat ID (e.g., -1001234567890)
